{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "avorlune",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "pages_build_output_dir": "./dist",

  // Top-level = local development (`wrangler pages dev`). .dev.vars overrides APP_ENV=development.
  "vars": { "APP_ENV": "development" },
  "d1_databases": [
    { "binding": "DB", "database_name": "avorlune-production", "database_id": "52632cba-6b60-44e9-ae3b-3bc82fdbeb43" }
  ],

  "env": {
    // Production branch (main) only.
    "production": {
      // Duitku: merchant code + API key are Cloudflare secrets (DUITKU_MERCHANT_CODE, DUITKU_API_KEY), never here.
      // Online checkout stays OFF until credentials are verified by /admin/payments/duitku/status and the owner approves.
      "vars": { "APP_ENV": "production", "DUITKU_ENV": "production", "DUITKU_CHECKOUT_ENABLED": "false" },
      "d1_databases": [
        { "binding": "DB", "database_name": "avorlune-production", "database_id": "52632cba-6b60-44e9-ae3b-3bc82fdbeb43" }
      ]
      // R2 private delivery (ADR-008) — add ONLY after owner approval, production env only:
      // "r2_buckets": [{ "binding": "DELIVERY_BUCKET", "bucket_name": "avorlune-assets" }]
    },
    // A1 — preview uses its OWN D1 (avorlune-preview, stamped app_meta.environment='preview') and no R2.
    // Bindings are non-inheritable in Pages env blocks, so production data is unreachable.
    // The app's env guard (app_meta.environment) is a second, independent barrier.
    // Clerk: DEVELOPMENT instance only (pk_test is browser-safe). CLERK_SECRET_KEY is never stored here.
    // Production gets NO Clerk vars until a Clerk production instance is approved (docs/79).
    "preview": {
      "vars": {
        "APP_ENV": "preview",
        "CLERK_PUBLISHABLE_KEY": "pk_test_ZXhvdGljLWtvaS03NjQyLmNsZXJrLmFjY291bnRzLmRldiQ",
        "CLERK_AUTHORIZED_PARTIES": "https://preview.avorlune.pages.dev"
      },
      "d1_databases": [
        { "binding": "DB", "database_name": "avorlune-preview", "database_id": "4cdfb666-052d-406b-9cff-23e2546f194d" }
      ]
    }
  }
}
